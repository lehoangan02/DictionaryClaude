{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LadyBird",
  "version": "0.8.0",
  "identifier": "dev.lexis.gre",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LadyBird",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' https://upload.wikimedia.org https://media.merriam-webster.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "app", "dmg"],
    "category": "Education",
    "shortDescription": "Offline GRE dictionary, thesaurus and quizzes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../data/packs/": "packs/" },
    "macOS": { "signingIdentity": "-", "entitlements": "entitlements.plist" }
  }
}
