[Unit]
Description=Lexis sync server
After=network-online.target
Wants=network-online.target

[Service]
User=lhan
ExecStart=/usr/local/bin/gredict-syncd --data /var/lib/lexis-syncd serve --lan 0.0.0.0:25 --wan 0.0.0.0:5025
# Ports below 1024 (the home-network port 25) need this capability; nothing else is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=lexis-syncd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
