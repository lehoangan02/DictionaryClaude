[Unit]
Description=LadyBird sync server
After=network-online.target
Wants=network-online.target

[Service]
User=lhan
Environment=HOME=/home/lhan
Environment=PATH=/home/lhan/.local/bin:/usr/local/bin:/usr/bin:/bin
# The agents are optional and only ever run when the person asks in the app.
Environment=LEXIS_CLAUDE_BIN=/home/lhan/.local/bin/claude
Environment=LEXIS_AGY_BIN=/home/lhan/.local/bin/agy
# Photos are read by a local vision model (Ollama: `ollama pull qwen2.5vl:3b`), with tesseract as the fallback.
Environment=LEXIS_OCR=auto
Environment=LEXIS_OCR_MODEL=qwen2.5vl:3b
# The server rebuilds itself after a chat merge that changes its code: it puts the new build here (a folder it owns)
# and exits once idle, and Restart= starts the new one. /usr/local/bin/gredict-syncd links to it for pair/devices/revoke.
Environment=LEXIS_SELF_UPDATE=/var/lib/lexis-syncd/bin/gredict-syncd
ExecStart=/var/lib/lexis-syncd/bin/gredict-syncd --data /var/lib/lexis-syncd --private /var/lib/lexis-syncd/private serve --lan 0.0.0.0:25 --wan 0.0.0.0:5025
# Ports below 1024 (the home-network port 25) need this one capability; nothing else is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
StateDirectory=lexis-syncd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
